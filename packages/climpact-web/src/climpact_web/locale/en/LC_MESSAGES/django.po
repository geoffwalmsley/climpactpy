#: help/topics.py:70 stations/sector_plots.py:333
#: stations/templates/stations/sector.html:64
msgid "Sector data"
msgstr ""

#: help/topics.py:78
msgid "The station file"
msgstr ""

#: help/topics.py:80
msgid ""
"A text file with one row per day and six columns: year, month, day, "
"precipitation (mm), maximum and minimum temperature (°C). Write missing "
"values as -99.9."
msgstr ""

#: help/topics.py:88
msgid "What the name is used for"
msgstr ""

#: help/topics.py:90
msgid ""
"Used in the names of the result files and on the plots. Letters, digits, "
"spaces and . ( ) - _ only."
msgstr ""

#: help/topics.py:98
msgid "Why the latitude matters"
msgstr ""

#: help/topics.py:100
msgid ""
"The latitude decides the hemisphere, and so the season used for the growing "
"season length and the Tx90 and Tn90 heatwaves. Latitude 0 counts as the "
"Southern Hemisphere, as in Climpact for R."
msgstr ""

#: help/topics.py:109
msgid "Does the longitude matter?"
msgstr ""

#: help/topics.py:110
msgid ""
"Recorded with the results. It does not change any index. Negative west of "
"Greenwich."
msgstr ""

#: help/topics.py:116
msgid "What is the base period?"
msgstr ""

#: help/topics.py:118
msgid ""
"The years the percentile thresholds are calculated from, for indices such as "
"TX90p, WSDI and R95p. Choose 30 years with good data if you can: 1961-1990 "
"for climate change studies, 1991-2020 for monitoring."
msgstr ""

#: help/topics.py:127
msgid "The batch metadata file"
msgstr ""

#: help/topics.py:129
msgid ""
"One line per station with its file name, latitude, longitude and index "
"settings, in 12 columns. Start from the sample metadata file."
msgstr ""

#: help/topics.py:137
msgid "Station files for a batch"
msgstr ""

#: help/topics.py:139
msgid ""
"Each file named in the metadata file, in the six-column station format. "
"Names must match exactly, including capitals and the extension."
msgstr ""

#: help/topics.py:147
msgid "One base period for every station"
msgstr ""

#: help/topics.py:149
msgid ""
"All stations in a batch use the same base period, so choose years that every "
"station has data for. A station with less than a year of data in it gets no "
"percentile indices."
msgstr ""

#: help/topics.py:158
msgid "Stations at the same time"
msgstr ""

#: help/topics.py:160
msgid ""
"How many stations are calculated in parallel, one per processor core. Leave "
"a core free if you want to keep using the computer."
msgstr ""

#: help/topics.py:168
msgid "Plots in a batch"
msgstr ""

#: help/topics.py:170
msgid ""
"Drawing a plot for every index takes about two thirds of the time. The index "
"tables and trend file are written either way."
msgstr ""

#: help/topics.py:179 stations/downloads.py:111 stations/qc_review.py:37
msgid "Outliers"
msgstr ""

#: help/topics.py:181
msgid ""
"Values far from the usual range for their calendar month: more than 3 "
"interquartile ranges beyond the box for temperatures, and 5 for "
"precipitation (days with rain only)."
msgstr ""

#: help/topics.py:190
msgid "Maximum below minimum"
msgstr ""

#: help/topics.py:192
msgid ""
"Days where the minimum temperature is equal to or higher than the maximum. "
"Usually a typing error or swapped columns."
msgstr ""

#: help/topics.py:200 stations/downloads.py:109 stations/qc_review.py:35
msgid "Values too large"
msgstr ""

#: help/topics.py:202
msgid ""
"Precipitation above 200 mm or below 0, and temperatures above 50 °C or below "
"-50 °C. They may be real, but check them."
msgstr ""

#: help/topics.py:210 stations/downloads.py:110 stations/qc_review.py:36
msgid "Repeated dates"
msgstr ""

#: help/topics.py:212
msgid ""
"Dates that appear more than once in the file. The indices use the last row "
"of a repeated date; remove the others."
msgstr ""

#: help/topics.py:220 stations/qc_review.py:38
msgid "Jumps in maximum temperature"
msgstr ""

#: help/topics.py:221
msgid ""
"Days where the maximum temperature changed by 20 °C or more from the day "
"before."
msgstr ""

#: help/topics.py:227 stations/qc_review.py:39
msgid "Jumps in minimum temperature"
msgstr ""

#: help/topics.py:228
msgid ""
"Days where the minimum temperature changed by 20 °C or more from the day "
"before."
msgstr ""

#: help/topics.py:234 stations/qc_review.py:40
msgid "Repeated maximum temperatures"
msgstr ""

#: help/topics.py:236
msgid ""
"The same maximum temperature on many days in a row (more than 5 by default), "
"which often means a value was copied forward."
msgstr ""

#: help/topics.py:244 stations/qc_review.py:41
msgid "Repeated minimum temperatures"
msgstr ""

#: help/topics.py:246
msgid ""
"The same minimum temperature on many days in a row (more than 5 by default), "
"which often means a value was copied forward."
msgstr ""

#: help/topics.py:254
msgid "Missing days per year"
msgstr ""

#: help/topics.py:256
msgid ""
"The number of missing days in each year for each variable. A year with more "
"than 15 missing days, or a month with more than 3, gets no index value."
msgstr ""

#: help/topics.py:264 stations/templates/stations/_qc_distributions.html:14
#: stations/templates/stations/_qc_distributions.html:33
msgid "Decimal values"
msgstr ""

#: help/topics.py:266
msgid ""
"How often each decimal (.0 to .9) occurs. Too many .0 or .5 values point to "
"rounding by observers, which affects counts of days above a threshold."
msgstr ""

#: help/topics.py:274
msgid "Precipitation histogram"
msgstr ""

#: help/topics.py:276
msgid ""
"How often each amount of daily precipitation of 1 mm or more occurs. Gaps or "
"spikes can show a change of instrument or reporting."
msgstr ""

#: help/topics.py:286
msgid ""
"The daily values of each variable over the whole record, with missing days "
"marked, to spot gaps and suspect values by eye."
msgstr ""

#: help/topics.py:294 stations/views_indices.py:211
msgid "Homogeneity"
msgstr ""

#: help/topics.py:296
msgid ""
"The checks do not test homogeneity: shifts caused by a station move or a new "
"instrument. Check and adjust for those with other tools before calculating "
"indices."
msgstr ""

#: help/topics.py:306 stations/forms.py:91
msgid "Outlier range for temperature"
msgstr ""

#: help/topics.py:308
msgid ""
"How many interquartile ranges beyond the box a temperature must be to count "
"as an outlier. Default 3; a smaller number flags more values."
msgstr ""

#: help/topics.py:316 stations/forms.py:101
msgid "Outlier range for precipitation"
msgstr ""

#: help/topics.py:318
msgid ""
"How many interquartile ranges beyond the box a day's precipitation must be "
"to count as an outlier. Default 5."
msgstr ""

#: help/topics.py:326 stations/forms.py:111
msgid "Largest daily precipitation"
msgstr ""

#: help/topics.py:327
msgid ""
"Daily precipitation above this amount (mm) is flagged for checking. Default "
"200."
msgstr ""

#: help/topics.py:333 stations/forms.py:118
msgid "Largest temperature"
msgstr ""

#: help/topics.py:335
msgid ""
"Temperatures above this value, or below its negative (°C), are flagged for "
"checking. Default 50."
msgstr ""

#: help/topics.py:343 stations/forms.py:128
msgid "Days without change"
msgstr ""

#: help/topics.py:345
msgid ""
"A temperature that stays exactly the same for more than this many days in a "
"row is flagged. Default 5."
msgstr ""

#: help/topics.py:353
msgid "Temperature change"
msgstr ""

#: help/topics.py:355
msgid ""
"A change from one day to the next of this many degrees (°C) or more is "
"flagged. Default 20."
msgstr ""

#: help/topics.py:364 help/topics.py:578 stations/forms_indices.py:115
msgid "Plot title"
msgstr ""

#: help/topics.py:365
msgid ""
"Printed at the top of every plot. The station name is used if you leave it "
"empty."
msgstr ""

#: help/topics.py:371 stations/forms_indices.py:121
#: stations/views_indices.py:333
msgid "Days for WSDId"
msgstr ""

#: help/topics.py:373
msgid ""
"How many days in a row the maximum temperature must be above its 90th "
"percentile to count towards WSDId. WSDI itself always uses 6. From 1 to 10; "
"default 1."
msgstr ""

#: help/topics.py:381 stations/forms_indices.py:128
#: stations/views_indices.py:334
msgid "Days for CSDId"
msgstr ""

#: help/topics.py:383
msgid ""
"How many days in a row the minimum temperature must be below its 10th "
"percentile to count towards CSDId. CSDI itself always uses 6. From 1 to 10; "
"default 1."
msgstr ""

#: help/topics.py:391 stations/forms_indices.py:135
#: stations/views_indices.py:335
msgid "Days for Rxdday"
msgstr ""

#: help/topics.py:393
msgid ""
"The length of the wettest spell Rxdday reports: the largest total over this "
"many days in a row. Rx1day and Rx5day are always calculated too. Default 3."
msgstr ""

#: help/topics.py:401 stations/forms_indices.py:141
#: stations/views_indices.py:336
msgid "Days for TXdTNd and TXbdTNbd"
msgstr ""

#: help/topics.py:403
msgid ""
"How many days in a row both the maximum and minimum temperature must be "
"above their 95th percentile (TXdTNd) or below their 5th (TXbdTNbd). Default "
"2."
msgstr ""

#: help/topics.py:411
msgid "Base temperature for heating degree days"
msgstr ""

#: help/topics.py:413
msgid ""
"HDDheat adds up how far the daily mean temperature falls below this value "
"(°C). Default 18."
msgstr ""

#: help/topics.py:421
msgid "Base temperature for cooling degree days"
msgstr ""

#: help/topics.py:423
msgid ""
"CDDcold adds up how far the daily mean temperature rises above this value "
"(°C). Default 18."
msgstr ""

#: help/topics.py:431
msgid "Base temperature for growing degree days"
msgstr ""

#: help/topics.py:433
msgid ""
"GDDgrow adds up how far the daily mean temperature rises above this value "
"(°C), the temperature a crop needs to grow. Default 10."
msgstr ""

#: help/topics.py:441
msgid "Rain amount for Rnnmm"
msgstr ""

#: help/topics.py:443
msgid ""
"Rnnmm counts the days with at least this much precipitation (mm). R10mm and "
"R20mm are always calculated too. Default 30."
msgstr ""

#: help/topics.py:451 stations/forms_indices.py:162
#: stations/views_indices.py:341
msgid "Extra SPI and SPEI time scale"
msgstr ""

#: help/topics.py:453
msgid ""
"SPI and SPEI are always calculated over 3, 6 and 12 months. This adds one "
"more time scale, in months. Default 24."
msgstr ""

#: help/topics.py:461 stations/results.py:63 stations/results.py:69
#: stations/templates/stations/indices.html:73
msgid "Your own index"
msgstr ""

#: help/topics.py:463
msgid ""
"Counts the days a variable (TX, TN, TM, DTR or precipitation) is above or "
"below a value you choose, for each year and month. TX ≥ 40 is written as "
"TXge40."
msgstr ""

#: help/topics.py:475
msgid ""
"The trend is the median of the slopes between every pair of years. Unlike a "
"least-squares line it is hardly affected by a few extreme years. Units are "
"the index's units per year."
msgstr ""

#: help/topics.py:484
msgid "Lower and upper bounds"
msgstr ""

#: help/topics.py:486
msgid ""
"The 95% confidence interval of the slope. If both bounds have the same sign, "
"the trend is significant at the 5% level."
msgstr ""

#: help/topics.py:494
msgid "Is the trend significant?"
msgstr ""

#: help/topics.py:496
msgid ""
"The trend file has no p-value. Read significance from the bounds: when the "
"interval from lower to upper bound does not include zero, the trend is "
"significant at the 5% level."
msgstr ""

#: help/topics.py:505
msgid "When there is no trend"
msgstr ""

#: help/topics.py:507
msgid ""
"A trend needs at least 10 values and at least 70% of the series present. "
"Otherwise the bounds and slope are left empty (NA)."
msgstr ""

#: help/topics.py:515
msgid "Seasonal trends"
msgstr ""

#: help/topics.py:517
msgid ""
"For monthly indices the trend file also gives trends for December-February, "
"March-May, June-August and September-November."
msgstr ""

#: help/topics.py:526
msgid "Missing values in the results"
msgstr ""

#: help/topics.py:528
msgid ""
"Years and months without enough data are written as -99.9 in the index "
"files. Remove them before calculating with the values in a spreadsheet."
msgstr ""

#: help/topics.py:536
msgid "Standardised values"
msgstr ""

#: help/topics.py:538
msgid ""
"Each value minus the mean of all years, divided by their standard deviation, "
"so indices with different units can be compared."
msgstr ""

#: help/topics.py:546
msgid "Threshold file"
msgstr ""

#: help/topics.py:548
msgid ""
"The percentile thresholds for each day of the year, calculated from the base "
"period. For interest; the indices have already used them."
msgstr ""

#: help/topics.py:556
msgid "What is in the download"
msgstr ""

#: help/topics.py:558
msgid ""
"Folders for the quality checks (qc), index tables (indices), plots, "
"thresholds (thres), trends (trend) and sector correlation (corr). The PDF "
"report is a separate download."
msgstr ""

#: help/topics.py:568
msgid "The sector data file"
msgstr ""

#: help/topics.py:570
msgid ""
"A CSV file of yearly values, such as crop yields: a first row of column "
"names, then a year and a value on each row. Write missing values as -99.9."
msgstr ""

#: help/topics.py:579
msgid ""
"Printed on each correlation plot. The station name is used if you leave it "
"empty."
msgstr ""

#: help/topics.py:585
msgid "Label for the y axis"
msgstr ""

#: help/topics.py:587
msgid ""
"The name and units of your sector data, for example Wheat yield (t/ha). "
"Taken from the file name if you leave it empty."
msgstr ""

#: help/topics.py:595
msgid "Detrend the sector data"
msgstr ""

#: help/topics.py:597
msgid ""
"Removes the long-term trend from the sector data before comparing. Without "
"it, a steady rise in yields from better farming can look like a link with "
"warming."
msgstr ""

#: help/topics.py:605
msgid "Correlation with the indices"
msgstr ""

#: help/topics.py:607
msgid ""
"The correlation coefficient (from -1 to 1) between the sector data and each "
"index, over the years both have. It shows association, not cause."
msgstr ""

#: help/topics.py:615
msgid "Regression on temperature"
msgstr ""

#: help/topics.py:617
msgid ""
"Scatter plots of the sector data against yearly mean maximum, minimum and "
"mean temperature and days above 30 °C, with a fitted line and R²."
msgstr ""

#: help/topics.py:626
msgid "Gridded input files"
msgstr ""

#: help/topics.py:628
msgid ""
"One to three CF netCDF files with daily maximum and minimum temperature and "
"precipitation on a shared time axis. Each variable must be in one file."
msgstr ""

#: help/topics.py:636
msgid "Variable names"
msgstr ""

#: help/topics.py:638
msgid ""
"The names of the maximum temperature, minimum temperature and precipitation "
"variables in your files, for example tasmax, tasmin and pr."
msgstr ""

#: help/topics.py:646
msgid "Base period for a grid"
msgstr ""

#: help/topics.py:648
msgid ""
"The years the percentile thresholds are calculated from in every cell. It "
"must lie within the files, unless you give a thresholds file."
msgstr ""

#: help/topics.py:658
msgid ""
"Percentile thresholds calculated earlier from another set of files, for "
"example a historical run, so that a future run uses the same thresholds."
msgstr ""

#: help/topics.py:667
msgid ""
"Choose fewer indices to finish sooner. Every index is calculated by default."
msgstr ""

#: help/topics.py:673
msgid "Output file names"
msgstr ""

#: help/topics.py:675
msgid ""
"One netCDF file per index and time scale, named in the CMIP5 style, for "
"example r20mm_ANN_climpactpy_historical_NA_1991-2010.nc."
msgstr ""

#: help/topics.py:683
msgid "Institution"
msgstr ""

#: help/topics.py:684
msgid ""
"Your institution's name and id, written into the output files' attributes."
msgstr ""

#: help/topics.py:690
