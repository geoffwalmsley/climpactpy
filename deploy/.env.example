# Settings for deploy/compose.yaml (#121). Copy to deploy/.env on the Droplet, fill in the
# secrets and keep it there only: `chmod 600 .env`, owned by the deploy user, never
# committed. Compose reads it for the variables in compose.yaml; each service gets only
# the ones it needs (the tunnel token reaches only cloudflared, the database password
# only the database and the app's DATABASE_URL). Every setting is described in
# TECHNICAL.md › Web front end › Settings.

# --- The app image -----------------------------------------------------------------
# The image a GitHub Release publishes (#122): a release's version, or `latest` for the
# last final release. A public package, so no registry login is needed.
CLIMPACT_IMAGE=ghcr.io/geoffwalmsley/climpact-web:X.Y.Z

# --- Secrets -----------------------------------------------------------------------
# Django's secret key: `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`.
CLIMPACT_WEB_SECRET_KEY=
# Postgres password, also put into DATABASE_URL, so keep it URL-safe: `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# The Cloudflare Tunnel's connector token (Zero Trust › Networks › Tunnels › the tunnel ›
# install command); only the `tunnel` profile needs it.
TUNNEL_TOKEN=

# --- The site ----------------------------------------------------------------------
# CLIMPACT_WEB_MODE=hosted is set by the image.
CLIMPACT_WEB_ALLOWED_HOSTS=climpact.app
CLIMPACT_WEB_CSRF_TRUSTED_ORIGINS=https://climpact.app
# Strict-Transport-Security max-age in seconds (one year), sent with includeSubDomains;
# 0 sends none. climpact.app is HTTPS-only anyway (.app is on the HSTS preload list), so
# a year is safe from the first deploy (#124). Leave Cloudflare's own HSTS setting off.
CLIMPACT_WEB_HSTS_SECONDS=31536000
# Largest request body (station uploads). Keep it at 100 or less: Cloudflare's free plan
# refuses bodies over 100 MB (with a 413) before they reach the app.
CLIMPACT_WEB_MAX_UPLOAD_MB=50
# Days a finished job and its files are kept.
CLIMPACT_WEB_RETENTION_DAYS=7
CLIMPACT_WEB_LOG_LEVEL=INFO

# --- Optional ----------------------------------------------------------------------
# Defaults to postgres://climpact:${POSTGRES_PASSWORD}@db:5432/climpact (the db service).
# DATABASE_URL=
# Gridded runs stay off in hosted mode (#12): leave CLIMPACT_WEB_GRIDDED_HOSTED unset.
